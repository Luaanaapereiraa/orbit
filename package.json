{
  "name": "orbit",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @destravai/web",
    "dev:web": "npm run dev -w @destravai/web",
    "build": "npm run typecheck -w @destravai/core && npm run build -w @destravai/web",
    "test": "npm test -w @destravai/core && npm test -w @destravai/web",
    "lint": "npm run lint -w @destravai/core && npm run lint -w @destravai/web"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^5.60.1",
    "@typescript-eslint/parser": "^5.60.1",
    "eslint": "^8.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.0.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom"
  }
}
